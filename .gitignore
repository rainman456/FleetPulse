# Build artifacts
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go tooling
/vendor/
# go.sum is intentionally NOT ignored: dependency lockfiles must be
# committed for reproducible CI builds (see docs/verify.md).

# Environment / local overrides
.env
.env.*
!.env.example

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS cruft
.DS_Store
Thumbs.db

# LocalStack / docker-compose volumes
.localstack/
docker/volumes/

# Terraform (infra/terraform/aws)
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl is intentionally committed (provider checksum pinning).

# Logs
*.log
